# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Project Settings → API). La anon key es pública: la seguridad la dan las reglas RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Dirección pública de la landing (sin barra final). Se usa para armar los enlaces.
VITE_LANDING_URL=http://localhost:5173
